# Credentials / secrets — never commit
.env
*.env
.auth.json
*.pem
*.key
*credentials*
*secret*
*token*.json

# Investigation artifacts — contain customer PII, logs, ticket data
# Static reference files (known-resolutions.md, product-capability-reference.md) ARE tracked
data/[0-9]*/
data/repro/

# Local reproduction assets — per-engineer, never commit
# repro/rpms/ contains downloaded RPMs + JFROG_MANIFEST.json (local paths, timestamps)
repro/

# Office / presentation files
~$*
*.pptx
*.ppt

# OS
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Local scratch
/tmp/
*.tmp
