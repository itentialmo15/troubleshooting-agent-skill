{
  "automation": {
    "name": "ISD-9244 - Netbox Delete Device Simulation",
    "description": "Simulates ISD-9244: creates a Netbox tag then calls deleteExtrasTagsId. The Netbox DELETE API returns HTTP 204 No Content (empty body) on success. The adapter translatorUtil.extractJSONEntity fails to validate the empty response and returns an AD.312 schema validation error even though the tag was deleted. taskStatus=error-on-delete = ISD-9244 confirmed.",
    "type": "automation",
    "canvasVersion": 3,
    "encodingVersion": 1,
    "font_size": 12,
    "tasks": {
      "workflow_start": {
        "name": "workflow_start",
        "groups": [],
        "nodeLocation": {"x": 120, "y": 1308}
      },
      "a1b2": {
        "name": "merge",
        "canvasName": "merge",
        "summary": "Build tag body",
        "description": "Assembles the JSON body for postExtrasTags. Merge is required because $var references do not resolve inside nested object values.",
        "location": "Application",
        "locationType": null,
        "app": "WorkFlowEngine",
        "type": "operation",
        "displayName": "WorkFlowEngine",
        "variables": {
          "incoming": {
            "data_to_merge": [
              {"key": "name", "value": {"task": "job", "variable": "tag_name"}},
              {"key": "slug", "value": {"task": "job", "variable": "tag_slug"}}
            ]
          },
          "outgoing": {
            "merged_object": null
          },
          "error": "",
          "decorators": []
        },
        "groups": [],
        "actor": "Pronghorn",
        "scheduled": false,
        "nodeLocation": {"x": 360, "y": 1308}
      },
      "b2c3": {
        "name": "postExtrasTags",
        "canvasName": "postExtrasTags",
        "summary": "Create Netbox Tag",
        "description": "Creates a test tag in Netbox. POST returns HTTP 201 with a body containing the created tag including its id. This step succeeds and provides the tag_id for the delete step.",
        "location": "Adapter",
        "locationType": "Netbox",
        "app": "Netbox",
        "type": "automatic",
        "displayName": "Netbox",
        "variables": {
          "incoming": {
            "data": "$var.a1b2.merged_object",
            "adapter_id": "$var.job.adapter_id"
          },
          "outgoing": {
            "result": null
          },
          "error": "",
          "decorators": []
        },
        "groups": [],
        "actor": "Pronghorn",
        "scheduled": false,
        "nodeLocation": {"x": 600, "y": 1308}
      },
      "ab01": {
        "name": "newVariable",
        "canvasName": "newVariable",
        "summary": "Set status = error-creating-tag",
        "description": "Error handler for postExtrasTags. If tag creation fails, record the error path and end the workflow.",
        "location": "Application",
        "locationType": null,
        "app": "WorkFlowEngine",
        "type": "operation",
        "displayName": "WorkFlowEngine",
        "variables": {
          "incoming": {
            "name": "taskStatus",
            "value": "error-creating-tag"
          },
          "outgoing": {
            "value": "$var.job.taskStatus"
          },
          "error": "",
          "decorators": []
        },
        "groups": [],
        "actor": "Pronghorn",
        "scheduled": false,
        "nodeLocation": {"x": 840, "y": 1440}
      },
      "c3d4": {
        "name": "query",
        "canvasName": "query",
        "summary": "Extract tag ID from create response",
        "description": "Extracts the id field from the postExtrasTags response. The adapter wraps the Netbox response — this query navigates to the id of the newly created tag.",
        "location": "Application",
        "locationType": null,
        "app": "WorkFlowEngine",
        "type": "automatic",
        "displayName": "WorkFlowEngine",
        "variables": {
          "incoming": {
            "obj": "$var.b2c3.result",
            "query": "response.id",
            "pass_on_null": false
          },
          "outgoing": {
            "return_data": null
          },
          "error": "",
          "decorators": []
        },
        "groups": [],
        "actor": "Pronghorn",
        "scheduled": false,
        "nodeLocation": {"x": 840, "y": 1308}
      },
      "d4e5": {
        "name": "deleteExtrasTagsId",
        "canvasName": "deleteExtrasTagsId",
        "summary": "Delete Netbox Tag by ID (ISD-9244 simulation)",
        "description": "Calls DELETE /api/extras/tags/{id}/ on Netbox. Netbox returns HTTP 204 No Content on success. The adapter translatorUtil.extractJSONEntity errors on the empty response body — AD.312 schema validation failure. This is the ISD-9244 symptom. The tag IS deleted even though the adapter returns error.",
        "location": "Adapter",
        "locationType": "Netbox",
        "app": "Netbox",
        "type": "automatic",
        "displayName": "Netbox",
        "variables": {
          "incoming": {
            "id": "$var.c3d4.return_data",
            "adapter_id": "$var.job.adapter_id"
          },
          "outgoing": {
            "result": null
          },
          "error": "",
          "decorators": []
        },
        "groups": [],
        "actor": "Pronghorn",
        "scheduled": false,
        "nodeLocation": {"x": 1080, "y": 1308}
      },
      "e5f6": {
        "name": "newVariable",
        "canvasName": "newVariable",
        "summary": "Set status = success-delete-returned-body",
        "description": "Reached only if the adapter returns a body response on delete (unexpected for HTTP 204). In practice this path is NOT taken for ISD-9244 scenarios.",
        "location": "Application",
        "locationType": null,
        "app": "WorkFlowEngine",
        "type": "operation",
        "displayName": "WorkFlowEngine",
        "variables": {
          "incoming": {
            "name": "taskStatus",
            "value": "success-delete-returned-body"
          },
          "outgoing": {
            "value": "$var.job.taskStatus"
          },
          "error": "",
          "decorators": []
        },
        "groups": [],
        "actor": "Pronghorn",
        "scheduled": false,
        "nodeLocation": {"x": 1320, "y": 1308}
      },
      "f601": {
        "name": "newVariable",
        "canvasName": "newVariable",
        "summary": "Set status = error-on-delete (ISD-9244 path)",
        "description": "Reached when the Netbox adapter errors on the delete response. For HTTP 204 No Content, this is the expected path — tag was deleted but adapter errored on empty body. Captures the error for inspection in job output.",
        "location": "Application",
        "locationType": null,
        "app": "WorkFlowEngine",
        "type": "operation",
        "displayName": "WorkFlowEngine",
        "variables": {
          "incoming": {
            "name": "taskStatus",
            "value": "error-on-delete"
          },
          "outgoing": {
            "value": "$var.job.taskStatus"
          },
          "error": "",
          "decorators": []
        },
        "groups": [],
        "actor": "Pronghorn",
        "scheduled": false,
        "nodeLocation": {"x": 1320, "y": 1440}
      },
      "workflow_end": {
        "name": "workflow_end",
        "groups": [],
        "nodeLocation": {"x": 1560, "y": 1308}
      }
    },
    "transitions": {
      "workflow_start": {
        "a1b2": {"type": "standard", "state": "success"}
      },
      "a1b2": {
        "b2c3": {"type": "standard", "state": "success"}
      },
      "b2c3": {
        "c3d4": {"type": "standard", "state": "success"},
        "ab01": {"type": "standard", "state": "error"}
      },
      "ab01": {
        "workflow_end": {"type": "standard", "state": "success"}
      },
      "c3d4": {
        "d4e5": {"type": "standard", "state": "success"}
      },
      "d4e5": {
        "e5f6": {"type": "standard", "state": "success"},
        "f601": {"type": "standard", "state": "error"}
      },
      "e5f6": {
        "workflow_end": {"type": "standard", "state": "success"}
      },
      "f601": {
        "workflow_end": {"type": "standard", "state": "success"}
      },
      "workflow_end": {}
    },
    "groups": [],
    "inputSchema": {
      "type": "object",
      "properties": {
        "adapter_id": {
          "title": "adapter_id",
          "type": "string",
          "description": "Netbox adapter instance name (e.g. 'Netbox'). Defaults to 'Netbox' if not provided."
        },
        "tag_name": {
          "title": "tag_name",
          "type": "string",
          "description": "Name for the test tag to create then delete. Defaults to 'isd-9244-test-tag'."
        },
        "tag_slug": {
          "title": "tag_slug",
          "type": "string",
          "description": "Slug for the test tag. Must match tag_name (lowercase, hyphenated). Defaults to 'isd-9244-test-tag'."
        }
      },
      "required": ["adapter_id"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "taskStatus": {
          "title": "taskStatus",
          "type": "string",
          "description": "error-creating-tag = create failed. success-delete-returned-body = delete unexpectedly returned a body. error-on-delete = adapter errored on HTTP 204 No Content (ISD-9244 symptom confirmed)."
        },
        "tag_id": {
          "title": "tag_id",
          "type": "number",
          "description": "ID of the tag that was created (and deleted) during the simulation."
        }
      }
    }
  }
}
