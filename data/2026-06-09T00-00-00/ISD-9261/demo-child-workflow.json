{
  "automation": {
    "name": "ISD-9261 - Child Demo",
    "description": "Demo child workflow for ISD-9261. Receives a single loop item (deviceName, configKey, configValue) from the parent's data_array loop. Sets taskStatus on completion. The childJobLoopIndex injected by the loop engine identifies which iteration this is.",
    "type": "automation",
    "canvasVersion": 3,
    "encodingVersion": 1,
    "font_size": 12,
    "tasks": {
      "workflow_start": {
        "name": "workflow_start",
        "groups": [],
        "nodeLocation": { "x": 200, "y": 600 }
      },
      "a1a1": {
        "name": "newVariable",
        "canvasName": "newVariable",
        "summary": "Simulate device config push (placeholder)",
        "description": "Placeholder for real adapter work. Uses deviceName, configKey, configValue from the parent loop item.",
        "location": "Application",
        "locationType": null,
        "app": "WorkFlowEngine",
        "type": "operation",
        "displayName": "WorkFlowEngine",
        "variables": {
          "incoming": {
            "name": "result",
            "value": "processed"
          },
          "outgoing": {
            "value": "$var.job.result"
          },
          "error": "",
          "decorators": []
        },
        "groups": [],
        "actor": "Pronghorn",
        "scheduled": false,
        "nodeLocation": { "x": 450, "y": 600 }
      },
      "b2b2": {
        "name": "newVariable",
        "canvasName": "newVariable",
        "summary": "Set taskStatus = success",
        "description": "Sets taskStatus so the parent loop can collect outcomes via job_details.loop.",
        "location": "Application",
        "locationType": null,
        "app": "WorkFlowEngine",
        "type": "operation",
        "displayName": "WorkFlowEngine",
        "variables": {
          "incoming": {
            "name": "taskStatus",
            "value": "success"
          },
          "outgoing": {
            "value": "$var.job.taskStatus"
          },
          "error": "",
          "decorators": []
        },
        "groups": [],
        "actor": "Pronghorn",
        "scheduled": false,
        "nodeLocation": { "x": 700, "y": 500 }
      },
      "c3c3": {
        "name": "newVariable",
        "canvasName": "newVariable",
        "summary": "Set taskStatus = error",
        "description": "Error path — sets taskStatus to error.",
        "location": "Application",
        "locationType": null,
        "app": "WorkFlowEngine",
        "type": "operation",
        "displayName": "WorkFlowEngine",
        "variables": {
          "incoming": {
            "name": "taskStatus",
            "value": "error"
          },
          "outgoing": {
            "value": "$var.job.taskStatus"
          },
          "error": "",
          "decorators": []
        },
        "groups": [],
        "actor": "Pronghorn",
        "scheduled": false,
        "nodeLocation": { "x": 700, "y": 700 }
      },
      "workflow_end": {
        "name": "workflow_end",
        "groups": [],
        "nodeLocation": { "x": 950, "y": 600 }
      }
    },
    "transitions": {
      "workflow_start": {
        "a1a1": { "type": "standard", "state": "success" }
      },
      "a1a1": {
        "b2b2": { "type": "standard", "state": "success" },
        "c3c3": { "type": "standard", "state": "error" }
      },
      "b2b2": {
        "workflow_end": { "type": "standard", "state": "success" }
      },
      "c3c3": {
        "workflow_end": { "type": "standard", "state": "success" }
      },
      "workflow_end": {}
    },
    "groups": [],
    "inputSchema": {
      "type": "object",
      "properties": {
        "deviceName": {
          "title": "deviceName",
          "type": "string",
          "description": "Device name — injected from parent data_array loop item"
        },
        "configKey": {
          "title": "configKey",
          "type": "string",
          "description": "Config parameter name — injected from parent data_array loop item"
        },
        "configValue": {
          "title": "configValue",
          "type": "string",
          "description": "Config parameter value — injected from parent data_array loop item"
        },
        "childJobLoopIndex": {
          "title": "childJobLoopIndex",
          "type": "number",
          "description": "Loop iteration index injected automatically by the WFE when parent uses loopType. This property is at the centre of ISD-9261 — the enable query handler tries to set childJobLoopIndex before the task config object exists."
        }
      },
      "required": ["deviceName"]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "taskStatus": {
          "type": "string",
          "description": "success or error — collected by parent via job_details.loop"
        },
        "result": {
          "type": "string"
        }
      }
    }
  }
}
